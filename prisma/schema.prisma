generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String              @id @default(cuid())
  firstName              String
  lastName               String
  email                  String              @unique
  passwordHash           String
  phone                  String?
  role                   UserRole            @default(USER)
  status                 UserStatus          @default(PENDING)
  emailVerified          Boolean             @default(false)
  lastLoginAt            DateTime?
  lastLoginIp            String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  accountActivities      AccountActivity[]
  adminApprovalsMade     AdminApproval[]     @relation("AdminApprovalActor")
  adminApprovalsFor      AdminApproval[]     @relation("AdminApprovalTarget")
  balance                Balance?
  balanceAdjustmentsMade BalanceAdjustment[] @relation("BalanceAdjustmentAdmin")
  balanceAdjustmentsFor  BalanceAdjustment[] @relation("BalanceAdjustmentUser")
  deposits               DepositRequest[]
  receivedMessages       DirectMessage[]     @relation("DirectMessageRecipient")
  sentMessages           DirectMessage[]     @relation("DirectMessageSender")
  files                  FileAsset[]
  kyc                    KycVerification?
  notifications          Notification[]
  otpCodes               OtpCode[]
  sessions               Session[]
  transactions           Transaction[]
  profile                UserProfile?
  withdrawals            WithdrawalRequest[]

  // Trading
  holdings               Holding[]
  trades                 Trade[]

  // Staking
  stakingPositions       StakingPosition[]
  stakingRewards         StakingReward[]

  // Trading Bots
  botActivations         BotActivation[]
  botTrades              BotTrade[]
  botSignals             BotSignal[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

model UserProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  avatarFileId String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  avatarFile   FileAsset? @relation("UserAvatar", fields: [avatarFileId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Balance {
  id        String   @id @default(cuid())
  userId    String   @unique
  available Decimal  @default(0) @db.Decimal(20, 8)
  locked    Decimal  @default(0) @db.Decimal(20, 8)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Holding {
  id           String   @id @default(cuid())
  userId       String
  symbol       String
  assetName    String?
  quantity     Decimal  @default(0) @db.Decimal(30, 12)
  averagePrice Decimal  @default(0) @db.Decimal(30, 12)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
  @@index([symbol])
}

model KycVerification {
  id                 String     @id @default(cuid())
  userId             String     @unique
  status             KycStatus  @default(NOT_STARTED)
  dateOfBirth        DateTime?
  nationality        String?
  countryOfResidence String?
  residentialAddress String?
  city               String?
  state              String?
  postalCode         String?
  governmentIdType   String?
  governmentIdNumber String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  declineReason      String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  idBackFile         FileAsset? @relation("KycIdBack")
  idFrontFile        FileAsset? @relation("KycIdFront")
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([submittedAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  codeHash  String
  purpose   OtpPurpose
  status    OtpStatus  @default(PENDING)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
}

model FileAsset {
  id                 String           @id @default(cuid())
  userId             String
  type               FileType
  originalName       String
  storageKey         String
  mimeType            String
  sizeBytes          Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  kycFrontForId      String?          @unique
  kycBackForId       String?          @unique

  paymentInvoiceFor  DepositRequest?  @relation("PaymentInvoice")
  depositsProofFor   DepositRequest?  @relation("DepositProof")
  kycBackFor         KycVerification? @relation("KycIdBack", fields: [kycBackForId], references: [id])
  kycFrontFor        KycVerification? @relation("KycIdFront", fields: [kycFrontForId], references: [id])
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarFor          UserProfile?     @relation("UserAvatar")

  @@index([userId])
  @@index([type])
}

model BankDepositAccount {
  id            String           @id @default(cuid())
  accountName   String
  bankName      String
  accountNumber String
  routingNumber String?
  swiftBic      String?
  bankAddress   String?
  instructions  String?
  isEnabled     Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  deposits DepositRequest[]

  @@index([isEnabled])
}

model CardDepositConfig {
  id           String   @id @default(cuid())
  paymentLink  String
  instructions String?
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CryptoDepositOption {
  id           String           @id @default(cuid())
  asset        String
  symbol       String
  network      String
  walletAddress String
  instructions String?
  isEnabled    Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  deposits DepositRequest[]

  @@index([isEnabled])
  @@index([symbol])
  @@index([network])
}

model PaymentDepositConfig {
  id                 String         @id @default(cuid())
  method             DepositMethod  @unique
  paymentInformation String
  instructions       String?
  isEnabled          Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  deposits DepositRequest[]

  @@index([isEnabled])
}

model WithdrawalMethodConfig {
  id           String           @id @default(cuid())
  method       WithdrawalMethod @unique
  displayName  String
  instructions String?
  isEnabled    Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([isEnabled])
}

model DepositRequest {
  id                    String                @id @default(cuid())
  userId                String
  method                DepositMethod
  status                DepositStatus         @default(PENDING)
  amount                Decimal               @db.Decimal(20, 8)
  reference             String?
  notes                 String?
  bankAccountId         String?
  cryptoOptionId        String?
  paymentConfigId       String?
  proofFileId           String?               @unique
  invoiceFileId         String?               @unique
  selectedBankName      String?
  selectedAccountName   String?
  selectedAccountNumber String?
  selectedRoutingNumber String?
  selectedSwiftBic      String?
  selectedBankAddress   String?
  cryptoAsset           String?
  cryptoSymbol          String?
  cryptoNetwork         String?
  cryptoWalletAddress   String?
  paymentInformation    String?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewAction          ReviewAction?
  declineReason         String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  adminApprovals        AdminApproval[]
  bankAccount           BankDepositAccount?   @relation(fields: [bankAccountId], references: [id])
  cryptoOption          CryptoDepositOption? @relation(fields: [cryptoOptionId], references: [id])
  invoiceFile           FileAsset?            @relation("PaymentInvoice", fields: [invoiceFileId], references: [id])
  paymentConfig         PaymentDepositConfig? @relation(fields: [paymentConfigId], references: [id])
  proofFile             FileAsset?            @relation("DepositProof", fields: [proofFileId], references: [id])
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]

  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@index([reviewedById])
}

model WithdrawalRequest {
  id                String           @id @default(cuid())
  userId            String
  method            WithdrawalMethod
  status            WithdrawalStatus @default(PENDING)
  amount            Decimal          @db.Decimal(20, 8)
  name              String?
  email             String?
  phone             String?
  tag               String?
  bankAccountName   String?
  bankAccountNumber String?
  routingNumber     String?
  swiftBic          String?
  bankName          String?
  bankAddress       String?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewAction      ReviewAction?
  declineReason     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  adminApprovals    AdminApproval[]
  transactions      Transaction[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@index([reviewedById])
}

model Transaction {
  id           String             @id @default(cuid())
  userId       String
  type         TransactionType
  status       TransactionStatus  @default(PENDING)
  amount       Decimal            @db.Decimal(20, 8)
  currency     String             @default("USD")
  description  String?
  depositId    String?
  withdrawalId String?
  reference    String?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  deposit      DepositRequest?    @relation(fields: [depositId], references: [id])
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawal   WithdrawalRequest? @relation(fields: [withdrawalId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([depositId])
  @@index([withdrawalId])
}

model Trade {
  id         String      @id @default(cuid())
  userId     String
  symbol     String
  assetName  String?
  side       TradeSide
  status     TradeStatus @default(COMPLETED)

  quantity   Decimal     @db.Decimal(30, 12)
  price      Decimal     @db.Decimal(30, 12)
  total      Decimal     @db.Decimal(20, 8)

  currency   String      @default("USD")
  reference  String      @unique
  executedAt DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([symbol])
  @@index([side])
  @@index([status])
  @@index([createdAt])
}

model AdminApproval {
  id                  String             @id @default(cuid())
  adminId             String
  userId              String
  depositId           String?
  withdrawalId        String?
  action              ReviewAction
  reason              String?
  createdAt           DateTime           @default(now())
  depositRequestId    String?
  withdrawalRequestId String?

  admin               User               @relation("AdminApprovalActor", fields: [adminId], references: [id])
  depositRequest      DepositRequest?    @relation(fields: [depositRequestId], references: [id])
  user                User               @relation("AdminApprovalTarget", fields: [userId], references: [id], onDelete: Cascade)
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])

  @@index([adminId])
  @@index([userId])
  @@index([depositId])
  @@index([withdrawalId])
  @@index([createdAt])
}

model BalanceAdjustment {
  id        String                @id @default(cuid())
  adminId   String
  userId    String
  type      BalanceAdjustmentType
  amount    Decimal               @db.Decimal(20, 8)
  currency  String                @default("USD")
  reason    String
  createdAt DateTime              @default(now())

  admin User @relation("BalanceAdjustmentAdmin", fields: [adminId], references: [id])
  user  User @relation("BalanceAdjustmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  subject     String?
  message     String
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipient User @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User      @relation("DirectMessageSender", fields: [senderId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
}

model AccountActivity {
  id          String       @id @default(cuid())
  userId      String
  type        ActivityType
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model PlatformSettings {
  id             String   @id @default(cuid())
  platformName   String   @default("NAXODEX")
  logoUrl        String?
  primaryColor   String   @default("#D4AF37")
  secondaryColor String   @default("#050505")
  accentColor    String   @default("#F4C542")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


// ============================================================
// NAXODEX MARKET DATA / ADVANCED CHARTS
// ============================================================

model MarketAsset {
  id            String        @id @default(cuid())
  symbol        String        @unique
  name          String
  assetType     MarketAssetType
  baseCurrency  String?
  quoteCurrency String        @default("USD")
  imageUrl      String?
  description   String?
  isActive      Boolean       @default(true)
  isWatchlistable Boolean     @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  prices        MarketPrice[]

  @@index([assetType])
  @@index([isActive])
  @@index([isWatchlistable])
}

model MarketPrice {
  id          String      @id @default(cuid())
  assetId     String
  timestamp   DateTime
  open        Decimal     @db.Decimal(30, 12)
  high        Decimal     @db.Decimal(30, 12)
  low         Decimal     @db.Decimal(30, 12)
  close       Decimal     @db.Decimal(30, 12)
  volume      Decimal?    @db.Decimal(30, 12)
  timeframe   ChartTimeframe @default(ONE_MINUTE)
  createdAt   DateTime    @default(now())

  asset       MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, timestamp])
  @@index([assetId, timeframe, timestamp])
  @@index([timestamp])
}


// ============================================================
// NAXODEX STAKING
// ============================================================

model StakingPlan {
  id                    String             @id @default(cuid())
  name                  String
  description           String?
  assetSymbol           String             @default("USD")
  minimumAmount         Decimal            @db.Decimal(20, 8)
  maximumAmount         Decimal?           @db.Decimal(20, 8)
  rewardRate             Decimal            @db.Decimal(10, 4)
  durationDays           Int
  rewardFrequency       StakingRewardFrequency @default(DAILY)
  calculationMethod     StakingCalculationMethod @default(SIMPLE)
  autoRenew             Boolean            @default(false)
  allowEarlyWithdrawal  Boolean            @default(false)
  earlyWithdrawalFee    Decimal            @default(0) @db.Decimal(10, 4)
  isActive              Boolean            @default(true)
  displayOrder          Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  positions             StakingPosition[]

  @@index([isActive])
  @@index([displayOrder])
}

model StakingPosition {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  principal          Decimal            @db.Decimal(20, 8)
  accruedReward      Decimal            @default(0) @db.Decimal(20, 8)
  claimedReward      Decimal            @default(0) @db.Decimal(20, 8)
  startAt            DateTime           @default(now())
  maturityAt         DateTime
  lastAccruedAt      DateTime?
  claimedAt          DateTime?
  completedAt        DateTime?
  status             StakingPositionStatus @default(ACTIVE)
  autoRenew          Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               StakingPlan        @relation(fields: [planId], references: [id])

  rewards            StakingReward[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([maturityAt])
  @@index([createdAt])
}

model StakingReward {
  id                 String             @id @default(cuid())
  userId             String
  positionId         String
  amount             Decimal            @db.Decimal(20, 8)
  currency           String             @default("USD")
  rewardDate         DateTime
  type               StakingRewardType  @default(ACCRUAL)
  reference          String             @unique
  createdAt          DateTime           @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  position           StakingPosition    @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([positionId])
  @@index([rewardDate])
  @@index([type])
}


// ============================================================
// NAXODEX TRADING BOTS
// ============================================================

model TradingBot {
  id                       String             @id @default(cuid())
  name                     String
  slug                     String             @unique
  description              String?
  imageUrl                 String?
  strategy                 BotStrategy
  status                   TradingBotStatus   @default(ACTIVE)

  // User eligibility
  minimumBalance           Decimal            @default(0) @db.Decimal(20, 8)
  maximumBalance           Decimal?           @db.Decimal(20, 8)
  minimumAllocation        Decimal            @default(0) @db.Decimal(20, 8)
  maximumAllocation        Decimal?           @db.Decimal(20, 8)

  // Commercial configuration
  activationFee            Decimal            @default(0) @db.Decimal(20, 8)
  subscriptionDays         Int?

  // Operational limits
  maxConcurrentTrades      Int                @default(1)
  maxDailyTrades           Int                @default(10)
  maxTradeDurationMinutes  Int                @default(15)
  maxTotalAllocation       Decimal?           @db.Decimal(20, 8)

  // Risk boundaries
  takeProfitPercent         Decimal?           @db.Decimal(10, 4)
  stopLossPercent            Decimal?           @db.Decimal(10, 4)
  minSignalConfidence       Decimal            @default(70) @db.Decimal(10, 4)

  // Market signal boundaries
  minShortTermMovePercent   Decimal?           @db.Decimal(10, 4)
  minMediumTermMovePercent  Decimal?           @db.Decimal(10, 4)

  // Presentation
  riskLevel                 BotRiskLevel       @default(MODERATE)
  isFeatured                Boolean             @default(false)
  displayOrder              Int                 @default(0)

  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  activations               BotActivation[]
  signals                   BotSignal[]
  trades                    BotTrade[]
  performanceSnapshots      BotPerformanceSnapshot[]

  @@index([strategy])
  @@index([status])
  @@index([isFeatured])
  @@index([displayOrder])
}

model BotActivation {
  id                 String             @id @default(cuid())
  userId             String
  botId              String
  allocatedAmount    Decimal            @db.Decimal(20, 8)
  activationFee      Decimal            @default(0) @db.Decimal(20, 8)
  startedAt          DateTime           @default(now())
  expiresAt          DateTime?
  stoppedAt          DateTime?
  status             BotActivationStatus @default(ACTIVE)
  totalProfit        Decimal            @default(0) @db.Decimal(20, 8)
  totalLoss          Decimal            @default(0) @db.Decimal(20, 8)
  totalTrades        Int                @default(0)
  winningTrades      Int                @default(0)
  losingTrades       Int                @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot                TradingBot         @relation(fields: [botId], references: [id])
  trades             BotTrade[]

  @@index([userId])
  @@index([botId])
  @@index([status])
  @@index([startedAt])
}

model BotSignal {
  id                    String             @id @default(cuid())
  userId                String
  botId                 String
  assetId               String?
  symbol                String
  strategy              BotStrategy
  direction             BotTradeDirection
  confidence            Decimal            @db.Decimal(10, 4)
  priceAtSignal         Decimal            @db.Decimal(30, 12)
  shortTermChange       Decimal?           @db.Decimal(10, 4)
  mediumTermChange      Decimal?           @db.Decimal(10, 4)
  signalReason          String?
  status                BotSignalStatus    @default(GENERATED)
  generatedAt           DateTime           @default(now())
  consumedAt            DateTime?
  createdAt             DateTime           @default(now())

  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot                   TradingBot         @relation(fields: [botId], references: [id])
  trade                 BotTrade?

  @@index([userId])
  @@index([botId])
  @@index([symbol])
  @@index([strategy])
  @@index([status])
  @@index([generatedAt])
}

model BotTrade {
  id                 String             @id @default(cuid())
  userId             String
  botId              String
  activationId       String
  signalId           String?            @unique

  symbol             String
  assetName          String?
  direction          BotTradeDirection
  status             BotTradeStatus     @default(OPEN)

  quantity           Decimal            @db.Decimal(30, 12)
  entryPrice         Decimal            @db.Decimal(30, 12)
  exitPrice          Decimal?           @db.Decimal(30, 12)

  allocatedAmount    Decimal            @db.Decimal(20, 8)
  entryValue         Decimal            @db.Decimal(20, 8)
  exitValue          Decimal?           @db.Decimal(20, 8)

  profitLoss          Decimal            @default(0) @db.Decimal(20, 8)
  profitLossPercent   Decimal            @default(0) @db.Decimal(10, 4)

  openedAt            DateTime           @default(now())
  closedAt            DateTime?
  closeReason         BotTradeCloseReason?
  reference           String             @unique

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot                 TradingBot        @relation(fields: [botId], references: [id])
  activation          BotActivation     @relation(fields: [activationId], references: [id], onDelete: Cascade)
  signal              BotSignal?        @relation(fields: [signalId], references: [id])

  @@index([userId])
  @@index([botId])
  @@index([activationId])
  @@index([symbol])
  @@index([direction])
  @@index([status])
  @@index([openedAt])
  @@index([closedAt])
}

model BotPerformanceSnapshot {
  id                 String             @id @default(cuid())
  botId              String
  periodStart        DateTime
  periodEnd          DateTime

  totalTrades        Int                @default(0)
  winningTrades      Int                @default(0)
  losingTrades       Int                @default(0)
  winRate            Decimal            @default(0) @db.Decimal(10, 4)

  grossProfit        Decimal            @default(0) @db.Decimal(20, 8)
  grossLoss          Decimal            @default(0) @db.Decimal(20, 8)
  netProfitLoss      Decimal            @default(0) @db.Decimal(20, 8)

  averageProfit      Decimal            @default(0) @db.Decimal(20, 8)
  averageLoss        Decimal            @default(0) @db.Decimal(20, 8)
  maxDrawdown        Decimal            @default(0) @db.Decimal(20, 8)

  ratingScore        Decimal            @default(0) @db.Decimal(10, 4)

  createdAt           DateTime           @default(now())

  bot                 TradingBot         @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, periodStart, periodEnd])
  @@index([botId])
  @@index([periodEnd])
}


// ============================================================
// EXISTING ENUMS
// ============================================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  DECLINED
}

enum OtpPurpose {
  LOGIN
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OtpStatus {
  PENDING
  USED
  EXPIRED
}

enum FileType {
  AVATAR
  GOVERNMENT_ID_FRONT
  GOVERNMENT_ID_BACK
  DEPOSIT_PROOF
  PAYMENT_INVOICE
